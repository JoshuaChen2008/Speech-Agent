{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "skipLibCheck": true
  },
  "include": [
    "src/caption/**/*",
    "src/toolbar/**/*",
    "src/settings/**/*",
    "src/history/**/*",
    "src/ui/**/*",
    "test/ui/**/*.ts",
    "test/ui/**/*.tsx",
    "vite.config.mts"
  ],
  "exclude": ["src/renderer-dist"]
}
