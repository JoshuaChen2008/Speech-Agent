# I2 evidence hashes bind exact JSON bytes; keep them stable across Windows checkouts.
docs/validation/i2-live-v4/*.json text eol=lf
docs/validation/i2-live-v4/**/*.json text eol=lf
docs/validation/i2-live-v5/*.json text eol=lf
docs/validation/i2-live-v5/**/*.json text eol=lf

# B5 evidence uses exact-byte SHA-256 links between fresh/restart reports,
# the run binding, and the release layout. Keep those links checkout-stable.
docs/validation/b5-*.json text eol=lf
docs/validation/i3-nonaudio-results.json text eol=lf

# The complete product payload is hashed as exact bytes and compared between
# packaged test and release ASARs on developer and hosted Windows worktrees.
# Pin every current product text type; binary payloads remain byte-exact.
src/**/*.css text eol=lf
src/**/*.html text eol=lf
src/**/*.js text eol=lf
src/**/*.json text eol=lf
src/**/*.md text eol=lf
src/**/*.mjs text eol=lf

# Downloaded CI evidence recomputes these exact text provenance inputs
# together with the product files above.
scripts/caption-layout-smoke.js text eol=lf
scripts/verify-caption-layout-report.js text eol=lf
package-lock.json text eol=lf
.github/workflows/ci.yml text eol=lf

# I3 non-audio source provenance is compared across developer and hosted
# Windows worktrees. Pin every text input to LF; the runner also canonicalizes
# legacy CRLF worktrees before hashing, without normalizing binary evidence.
src/history/history.js text eol=lf
src/main/services/history-service.js text eol=lf
scripts/i3-nonaudio-soak.js text eol=lf
src/main/session/session-coordinator.js text eol=lf
src/main/services/sqlite-session-recorder.js text eol=lf
src/runtime/storage-worker/subtitle-store.js text eol=lf
scripts/strict-evidence-json.js text eol=lf
src/main/services/storage-gateway.js text eol=lf
src/runtime/storage-worker/worker-service.js text eol=lf
scripts/verify-i3-nonaudio-report.js text eol=lf

# I4 non-audio reports bind an exact fixture and may be collected on another
# Windows snapshot. Keep both the source fixture and any future report stable.
scripts/fixtures/i4-nonaudio-legacy-session.jsonl text eol=lf
docs/validation/i4-nonaudio-*.json text eol=lf
