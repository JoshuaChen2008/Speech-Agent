{
  "name": "live-subtitle-agent",
  "version": "0.1.0",
  "description": "Win11 本地实时字幕系统，后置可选 Agent Loop、上下文增强与会议摘要",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/run-supervised-electron.js --entry .",
    "test": "node --test --experimental-test-isolation=none",
    "test:integration": "node --test --experimental-test-isolation=none \"test/integration/**/*.test.js\"",
    "test:ci": "npm run test:integration && npm test",
    "preview:fixtures": "node scripts/build-preview-fixtures.js",
    "package:smoke": "electron-builder --config electron-builder.smoke.config.cjs --win dir --x64 --publish never",
    "package:release": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4"
  }
}
