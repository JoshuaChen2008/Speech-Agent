{
  "name": "live-subtitle-agent",
  "version": "0.1.0",
  "description": "Win11 本地实时字幕系统，后置可选 Agent Loop、上下文增强与会议摘要",
  "main": "src/main.js",
  "scripts": {
    "dev": "node scripts/run-renderer-dev.js",
    "build:renderer": "vite build",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "verify:renderer": "npm run typecheck:renderer && npm run build:renderer",
    "prestart": "npm run verify:renderer",
    "start": "node scripts/run-supervised-electron.js --entry .",
    "test": "npm run test:core && npm run test:integration && npm run test:evidence",
    "test:core": "node --test --experimental-test-isolation=none \"test/contracts/**/*.test.js\" \"test/main/**/*.test.js\" \"test/runtime/**/*.test.js\" \"test/storage/**/*.test.js\" \"test/ui/**/*.test.js\"",
    "test:integration": "node --test --experimental-test-isolation=none \"test/integration/**/*.test.js\"",
    "test:evidence": "node --test --experimental-test-isolation=none \"test/gate-0b/**/*.test.js\" \"test/gate-0c/**/*.test.js\" \"test/validation/**/*.test.js\"",
    "test:ci": "npm test",
    "pretest:core": "npm run verify:renderer",
    "pretest:integration": "npm run verify:renderer",
    "pretest:evidence": "npm run verify:renderer",
    "electron:install": "install-electron",
    "preview:fixtures": "node scripts/build-preview-fixtures.js",
    "prepackage:smoke": "npm run verify:renderer",
    "package:smoke": "electron-builder --config electron-builder.smoke.config.cjs --win dir --x64 --publish never",
    "prepackage:release": "npm run verify:renderer",
    "package:release": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@electron/asar": "3.4.1",
    "@fluentui/svg-icons": "1.1.335",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sherpa-onnx-node": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4"
  }
}
